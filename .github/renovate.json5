{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:allNonMajor',
    ':semanticCommits',
    // cliff.toml skips chore(deps), keeping bumps out of the release notes.
    ':semanticCommitTypeAll(chore)',
  ],

  timezone: 'Europe/Paris',
  schedule: ['before 9am on monday'],
  labels: ['dependencies'],
  prConcurrentLimit: 3,

  // `zellij-tile = "0.44"` means patch releases only move Cargo.lock — and the
  // release notes read the advertised Zellij floor from that lock.
  rangeStrategy: 'update-lockfile',

  // Resolved after the presets, so this un-groups zellij-tile: it pins the
  // plugin ABI, and Cargo treats a 0.x minor as breaking.
  packageRules: [
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['zellij-tile'],
      groupName: null,
      separateMinorPatch: true,
      addLabels: ['compatibility'],
      prBodyNotes: [
        '⚠️ `zellij-tile` pins the plugin ABI. Rebuild against the matching Zellij and update the version floor in the README before merging a minor bump.',
      ],
    },
  ],

  // No automerge: CI proves it builds, not that it still loads in Zellij.
}
